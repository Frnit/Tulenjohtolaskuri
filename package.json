{
  "name": "tulenjohtolaskuri-test-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.x"
  },
  "scripts": {
    "serve:test": "node tests/support/test-server.mjs",
    "test:node:characterization": "node scripts/run-node-tests.mjs characterization",
    "test:node:defects": "node scripts/run-node-tests.mjs defects",
    "test:target": "node scripts/run-node-tests.mjs target",
    "test:browser:characterization": "playwright test --grep @characterization --grep-invert @pwa",
    "test:browser:defects": "playwright test --grep @known-defect",
    "test:browser:target": "playwright test --grep @target",
    "test:pwa": "playwright test tests/pwa --workers=1",
    "test": "pnpm run test:node:characterization && pnpm run test:node:defects && pnpm run test:target && pnpm run test:browser:characterization && pnpm run test:browser:defects && pnpm run test:browser:target && pnpm run test:pwa"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
